@model Pluralsight.CleanArchitecture.Web.ViewModels.RecipeDeleteViewModel
@{
    ViewData["Title"] = "Delete Recipe";
}

<h1>Delete Recipe</h1>

<div class="alert alert-warning">
    <p>Are you sure you want to delete this recipe?</p>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@Model.CategoryName</dd>

            <dt class="col-sm-4">Difficulty</dt>
            <dd class="col-sm-8">@Model.DifficultyLevel / 5</dd>

            <dt class="col-sm-4">Prep Time</dt>
            <dd class="col-sm-8">@Model.PrepTimeInMinutes min</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
